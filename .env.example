# ============================================================================
#  FotoHu — required
# ============================================================================

# Encrypts the cloud tokens stored in the database. Generate once and keep it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means re-linking every cloud account.
FOTOHU_SECRET_KEY=

# One-time token that turns the first person to send `/start <token>` into the
# admin. It stops working the moment anyone is registered.
FOTOHU_BOOTSTRAP_TOKEN=change-me-once

# ============================================================================
#  Messengers — set at least one
# ============================================================================

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# From the Viber admin panel: https://partners.viber.com
# Viber REQUIRES a public HTTPS webhook, so FOTOHU_PUBLIC_URL must be set too.
VIBER_BOT_TOKEN=
VIBER_BOT_NAME=FotoHu

# ============================================================================
#  Public address
# ============================================================================
# Needed for: Viber, and for linking OneDrive / Google Drive by OAuth.
# Telegram alone works without it (long polling).
# With the `tls` compose profile, Caddy issues the certificate automatically.
FOTOHU_PUBLIC_URL=
FOTOHU_DOMAIN=

# Optional: receive Telegram updates by webhook instead of long polling.
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_SECRET=

# ============================================================================
#  Cloud storage app credentials
# ============================================================================
# Register at https://entra.microsoft.com (Azure AD app registration).
# Redirect URI: <FOTOHU_PUBLIC_URL>/oauth/callback  (type: Web)
# Delegated permissions: Files.ReadWrite, offline_access, User.Read
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# Register at https://console.cloud.google.com (OAuth client, type "Web application").
# Redirect URI: <FOTOHU_PUBLIC_URL>/oauth/callback
# Enable the Google Drive API for the project.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=

# Box, Dropbox, pCloud, Yandex.Disk, WebDAV, S3, … — set these up with
# `rclone config` and point the bot at the resulting remote name.
RCLONE_BINARY=rclone
RCLONE_CONFIG=/data/rclone.conf

# ============================================================================
#  Self-hosted Telegram Bot API (compose profile `local-api`)
# ============================================================================
# Raises the bot download limit from 20 MB to 2 GB. Credentials from
# https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Uncomment both when running the local-api profile:
# TELEGRAM_API_BASE=http://telegram-bot-api:8081
# TELEGRAM_API_LOCAL_MODE=true

# ============================================================================
#  Misc
# ============================================================================
FOTOHU_DATA_DIR=/data

# The HTTP surface (/health always; the Viber and Telegram webhooks and the
# OAuth callback when configured). Bound to 127.0.0.1 by default, so a bare
# metal install opens nothing on the LAN. Leave this commented out under Docker:
# the image already sets 0.0.0.0, and a value here would override it and break
# the published port. Uncomment only for bare metal behind a proxy on another
# host.
# FOTOHU_HTTP_HOST=0.0.0.0
FOTOHU_HTTP_PORT=8080
FOTOHU_LOG_LEVEL=INFO
FOTOHU_LANGUAGE=ru
FOTOHU_WORKER_CONCURRENCY=2

# Write logs to a file as well as the console. Set this when running as a
# background service with no console to watch (Windows Task Scheduler, systemd).
# The file rotates automatically (2 MB x 5).
# FOTOHU_LOG_FILE=/data/bot.log

# ============================================================================
#  Running without Docker, e.g. on Windows
# ============================================================================
# rclone lives elsewhere than PATH (downloaded manually, blocked by antivirus):
# RCLONE_BINARY=C:\fotohu\bin\rclone.exe
# RCLONE_CONFIG=C:\fotohu\data\rclone.conf
#
# TLS is handled automatically: the bot verifies against the OS trust store
# (truststore package), so an HTTPS-inspecting antivirus or corporate proxy
# needs no extra configuration.
